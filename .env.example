# Contact form email delivery (used only by the server route /api/contact).
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Provider: Resend (https://resend.com). Without all three values, direct sending is
# disabled and Mail offers drafts, copy, and a mailto: fallback instead.

# The only address that ever receives messages. Visitors cannot change it.
CONTACT_RECIPIENT_EMAIL=
# A bare sender address (no display name) on a domain you have verified with the provider.
EMAIL_FROM_ADDRESS=
# Server-side API key. Do not prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# GitHub repositories (used only by the server routes under /api/github).
# The GitHub account whose public repositories appear in the portfolio. If this is empty, the GitHub profile
# URL in src/config/site.ts is used instead; if neither is set, the GitHub app shows a setup message.
GITHUB_USERNAME=
# Optional. A token raises GitHub's rate limit from 60 to 5,000 requests per hour. It is only ever read on the
# server and is never exposed to the browser. Leave empty to use anonymous access (public data only).
GITHUB_TOKEN=

# Public address of the deployed site, e.g. https://your-domain.example (no path). Optional. When set, it
# becomes the canonical URL and the base for Open Graph links. Leave empty until the domain is decided;
# nothing is guessed.
SITE_URL=
