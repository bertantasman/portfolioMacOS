{
  "name": "macos-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "NODE_NO_WARNINGS=1 node --import ./scripts/register.mjs --test \"tests/**/*.test.ts\"",
    "resume": "NODE_NO_WARNINGS=1 node --import ./scripts/register.mjs scripts/resume-data.ts > resume.tmp.json && swift scripts/render-resume.swift resume.tmp.json public/documents/Resume.pdf; rm -f resume.tmp.json",
    "audit": "NODE_NO_WARNINGS=1 node --import ./scripts/register.mjs scripts/audit.ts",
    "stats-report": "NODE_NO_WARNINGS=1 node --import ./scripts/register.mjs scripts/statistics-report.ts"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
